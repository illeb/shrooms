# ---------- Postgres (docker compose) ----------
POSTGRES_USER=mushrooms
POSTGRES_PASSWORD=mushrooms
POSTGRES_DB=mushrooms
POSTGRES_PORT=55432

# ---------- API ----------
API_PORT=4000
DATABASE_URL="postgresql://mushrooms:mushrooms@localhost:55432/mushrooms?schema=public"
NODE_ENV=development
LOG_LEVEL=debug
GRAPHQL_PLAYGROUND=true

# ---------- Ingestione ----------
# Abilita/disabilita lo scheduler interno (i comandi CLI restano sempre usabili)
INGESTION_CRON_ENABLED=false
INGESTION_CRON="0 30 5 * * *"
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com
ARPAE_OPENDATA_BASE_URL=https://dati-simc.arpae.it/opendata/osservati/meteo
MARCHE_API_BASE_URL=https://apimeteo.regione.marche.it

# ---------- Web ----------
WEB_PORT=3000
NUXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
