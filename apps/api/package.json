{
  "name": "@mushrooms/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS: ingestione meteo, motore di previsione, API GraphQL.",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/src/main.js",
    "cli": "tsx src/cli/main.cli.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist src/generated *.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@mushrooms/graphql-schema": "workspace:*",
    "@mushrooms/mycology-core": "workspace:*",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shapefile": "^0.6.6",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.4.1",
    "@types/shapefile": "^0.6.4",
    "dotenv": "^17.2.4",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
