// Schema Prisma.
//
// Step 2: anagrafica stazioni + osservazioni giornaliere grezze.
// Step 3: feature store, profili di specie versionati, punteggi di buttata.
//
// Gli id usano gen_random_uuid() lato Postgres e non uuid() lato client:
// l'ingestione inserisce le osservazioni con un INSERT multi-riga in SQL
// grezzo (ON CONFLICT DO UPDATE), che senza default sul database fallirebbe.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  /// Intervallo coperto solo in parte (tipicamente un rate limit): i dati
  /// scaricati sono validi e persistiti, rilanciare riprende da dove si era
  /// fermato.
  PARTIAL
  FAILED
}

/// Tipo di bosco dominante in una cella, dalla Carta forestale regionale 2025.
///
/// Piu' fine di una semplice divisione latifoglie/conifere perche' e' quello
/// che la carta distingue e perche' ai funghi interessa: la faggeta d'alta
/// quota e la cerreta di collina buttano in momenti diversi, e ospitano
/// specie di porcino diverse.
enum ForestType {
  /// Faggete. Il porcino d'alta quota, fine estate e autunno.
  FAGGETA
  /// Castagneti. Fascia media, spesso il primo a partire.
  CASTAGNETO
  /// Cerrete (Quercus cerris). Collina e bassa montagna.
  CERRETA
  /// Boschi di roverella, rovere, farnia.
  QUERCETO
  /// Orno-ostrieti: carpino nero e orniello, il bosco magro di versante.
  ORNO_OSTRIETO
  /// Pinete, abetine, rimboschimenti di conifere.
  CONIFERE
  /// Boschi misti senza una specie nettamente prevalente.
  MISTO
  /// Robinieti, pioppeti, arbusteti: bosco che non fa porcini.
  ALTRO
}

/// Sorgenti dati registrate. Aggiungerne una richiede un adapter e una voce qui.
enum WeatherSourceCode {
  /// Arpae SIMC, Emilia-Romagna. Osservato, rete a terra.
  ARPAE_ER
  /// Open-Meteo. Modellato su griglia: copertura totale e previsione.
  OPEN_METEO
  /// AMAP Marche. Anagrafica aperta, misure su richiesta.
  MARCHE_AMAP
  /// SIR Toscana. Solo scraping.
  SIR_TOSCANA
}

/// Traccia di ogni esecuzione di ingestione: quando qualcosa non torna,
/// si vede subito quale sorgente, quale intervallo e quale errore.
model IngestionRun {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source       String          @db.VarChar(64)
  rangeFrom    DateTime        @db.Date
  rangeTo      DateTime        @db.Date
  status       IngestionStatus @default(RUNNING)
  rowsRead     Int             @default(0)
  rowsWritten  Int             @default(0)
  errorMessage String?
  startedAt    DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?       @db.Timestamptz(3)
  durationMs   Int?

  @@index([source, startedAt(sort: Desc)])
  @@index([status])
  @@map("ingestion_run")
}

/// Punto di misura. Per una sorgente a griglia (Open-Meteo) e' la cella
/// interrogata, non un impianto fisico: al modello la differenza non importa,
/// conta che le coordinate siano stabili nel tempo.
model Station {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     WeatherSourceCode
  /// Identificativo stabile nella sorgente. Per Arpae: "rete:lon:lat".
  externalId String            @db.VarChar(128)
  name       String            @db.VarChar(160)
  network    String?           @db.VarChar(64)

  latitude  Float
  longitude Float
  altitudeM Float?

  /// Derivati dalle coordinate con `stations:geocode`, non dalla sorgente:
  /// Arpae non pubblica la provincia, e marca come Emilia-Romagna anche le
  /// stazioni di confine che stanno in Liguria o Toscana.
  region       String? @db.VarChar(64)
  province     String? @db.VarChar(8)
  provinceName String? @db.VarChar(64)
  active       Boolean @default(true)

  /// Primo e ultimo giorno per cui esiste almeno un'osservazione.
  firstObservedOn DateTime? @db.Date
  lastObservedOn  DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  observations DailyObservation[]
  features     DailyStationFeature[]
  predictions  FruitingPrediction[]
  /// Valorizzata solo per le stazioni sintetiche che rappresentano una cella.
  site         PredictionSite?      @relation("SiteStation")

  @@unique([source, externalId])
  @@index([latitude, longitude])
  @@index([altitudeM])
  @@index([region, active])
  @@map("station")
}

/// Osservazione giornaliera grezza, come arrivata da UNA sorgente.
///
/// Una stazione puo' avere piu' righe per lo stesso giorno, una per sorgente:
/// Arpae per temperatura e pioggia, Open-Meteo per il suolo. Il merge per
/// priorita' avviene a valle, quando si calcolano le feature (step 3), cosi'
/// il grezzo resta sempre ricostruibile.
///
/// Convenzione: `date` e' la mezzanotte UTC del giorno locale Europe/Rome a
/// cui i valori si riferiscono. Vale per tutte le sorgenti.
///
/// Invariante: qui non entrano mai dati futuri. Il sistema stabilisce se le
/// condizioni ci sono ADESSO guardando la pioggia caduta e le temperature che
/// l'hanno seguita, non prevedendo il meteo dei prossimi giorni.
model DailyObservation {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId String            @db.Uuid
  station   Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  date      DateTime          @db.Date
  source    WeatherSourceCode

  tMeanC    Float?
  tMinC     Float?
  tMaxC     Float?
  precipMm  Float?
  rhMeanPct Float?

  /// Temperatura del suolo. Nessuna rete Arpae la misura: viene da Open-Meteo,
  /// tranne che nelle Marche dove esistono sensori reali a 5/10/20/30/50 cm.
  soilT0To7C  Float?
  soilT7To28C Float?
  /// Umidita' volumetrica del suolo, m3/m3.
  soilMoisture0To7 Float?

  /// Numero di misure sotto-giornaliere che hanno prodotto l'aggregato.
  /// Nullo per le sorgenti che pubblicano gia' il giornaliero.
  sampleCount Int?

  ingestedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([stationId, date, source])
  @@index([date])
  @@index([stationId, date])
  @@index([source, date])
  @@map("daily_observation")
}

/// Feature giornaliere calcolate, pronte per il motore di scoring.
///
/// Le feature stanno in JSONB e non in una colonna ciascuna: l'insieme cambia
/// mentre il modello si affina, e ogni aggiunta richiederebbe una migrazione.
/// Nessuna query filtra per singola feature - il motore legge righe intere -
/// quindi la rigidita' relazionale non pagherebbe nulla.
model DailyStationFeature {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId String   @db.Uuid
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  /// Serializzazione di DailyFeatures (@mushrooms/mycology-core).
  features Json

  /// True finche' il bilancio idrico non ha dimenticato la condizione iniziale:
  /// i primi ~60 giorni di ogni serie non sono affidabili.
  warmup Boolean @default(false)

  computedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([stationId, date])
  @@index([date])
  @@map("daily_station_feature")
}

/// Profilo di specie versionato.
///
/// E' il file che si modifica per tarare il modello. Vive a database e non solo
/// su disco perche' ogni punteggio registra con quale versione e' stato
/// prodotto: due tarature diverse possono convivere e vanno confrontate a
/// parita' di dati.
model SpeciesModel {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  species String  @db.VarChar(64)
  version Int
  label   String  @db.VarChar(160)

  /// Serializzazione di SpeciesProfile (@mushrooms/mycology-core).
  profile Json

  /// Solo una versione per specie e' attiva alla volta.
  active Boolean @default(false)

  /// Da dove arriva: "builtin" o il percorso del file YAML caricato.
  source String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  predictions FruitingPrediction[]

  @@unique([species, version])
  @@index([species, active])
  @@map("species_model")
}

/// Punteggio di buttata per una stazione in un giorno.
///
/// Persistito e non calcolato al volo perche' la domanda che l'applicazione
/// deve saper rispondere in fretta e' "dove sono le condizioni migliori oggi",
/// cioe' un ordinamento su tutte le stazioni.
model FruitingPrediction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stationId String   @db.Uuid
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  modelId String       @db.Uuid
  model   SpeciesModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  /// 0-100.
  score Float
  class String @db.VarChar(16)

  triggerScore      Float
  phenologyScore    Float
  daysSinceWetEvent Int?
  warmup            Boolean @default(false)

  /// Contributo di ogni regola e inibitori attivi: rende il punteggio
  /// ispezionabile invece che un numero calato dall'alto.
  detail Json

  computedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([stationId, date, modelId])
  @@index([date, score(sort: Desc)])
  @@index([modelId, date])
  @@map("fruiting_prediction")
}

/// Confini provinciali italiani, per attribuire provincia e regione a una
/// stazione dalle sue coordinate.
///
/// La geometria e' `Unsupported`: Prisma sa crearla in migrazione ma non
/// leggerla, e va bene cosi' - l'unica query che la tocca e' un ST_Contains
/// in SQL grezzo. Fonte: openpolis/geojson-italy (ISTAT).
model ProvinceBoundary {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Sigla automobilistica: PR, MO, BO...
  acronym   String @unique @db.VarChar(8)
  name      String @db.VarChar(64)
  region    String @db.VarChar(64)
  istatCode String @db.VarChar(8)

  geom Unsupported("geometry(MultiPolygon, 4326)")

  importedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("province_boundary")
}

/// Cella di bosco su cui si calcola la previsione.
///
/// E' il pezzo che separa "dove misuriamo" da "dove cerchiamo i funghi": le
/// stazioni stanno dove qualcuno ha messo un termometro, di solito a fondovalle;
/// i porcini stanno nel bosco, in quota, sui versanti. Una cella e' un esagono
/// di ~3 km centrato nel bosco, con la sua specie dominante e la sua quota.
///
/// Ogni sito ha una `Station` gemella con `source = OPEN_METEO`: e' cosi' che
/// riusa senza modifiche l'ingestione, il feature store e il motore di scoring.
/// Nel nostro schema una "stazione" e' gia' definita come punto di misura, non
/// come impianto fisico.
model PredictionSite {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Identificativo stabile derivato dalle coordinate: "bosco:LAT:LON".
  code String @unique @db.VarChar(64)

  latitude  Float
  longitude Float
  /// Quota del centro cella, dal modello digitale del terreno di Open-Meteo.
  altitudeM Float

  forestType  ForestType
  /// Codice e descrizione originali della carta regionale, per tracciabilita'.
  forestCode  String @db.VarChar(8)
  forestLabel String @db.Text

  /// Quanta parte dell'esagono e' davvero bosco, 0..1.
  ///
  /// Il campionamento puntuale non poteva dirlo: sapeva che nel punto c'era
  /// una faggeta, non se ne coprisse l'80% della cella o il 20%. Con la carta
  /// forestale a database si misura l'area, e la differenza conta: una cella
  /// boscata per intero e' una scommessa diversa da una a mosaico coi prati.
  forestFraction Float?

  /// Governo del bosco (ceduo, fustaia...) dalla carta regionale.
  ///
  /// Non entra nel punteggio, ma un ceduo giovane e una fustaia matura non
  /// danno la stessa raccolta a parita' di meteo, e chi legge la mappa lo sa.
  management String? @db.Text

  province     String? @db.VarChar(8)
  provinceName String? @db.VarChar(64)
  region       String? @db.VarChar(64)

  /// La stazione gemella su cui girano osservazioni, feature e punteggi.
  stationId String  @unique @db.Uuid
  station   Station @relation("SiteStation", fields: [stationId], references: [id], onDelete: Cascade)

  /// Quanto dista la stazione osservata piu' vicina: dice quanta fiducia
  /// merita il punteggio. Una cella a 10 km da ogni termometro e' pura griglia.
  nearestStationKm Float?

  /// L'esagono, per disegnarlo in mappa.
  geom Unsupported("geometry(Polygon, 4326)")

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([forestType, altitudeM])
  @@index([region, province])
  @@map("prediction_site")
}

/// Poligono della Carta forestale regionale 2025 (Regione Emilia-Romagna).
///
/// E' la carta forestale vera, non l'uso del suolo: distingue Cerrete da
/// Faggete da Orno-ostrieti, riporta la specie botanica prevalente e il
/// governo del bosco. Fotointerpretazione del volo AGEA 2023.
///
/// Caricata da shapefile provinciali, riproiettata da RDN2008/UTM32 (EPSG:7791)
/// a WGS84. Serve a classificare le celle per **dominanza di area**, che e'
/// piu' onesto del campionamento puntuale che usavamo prima.
model ForestPolygon {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// OBJECTID nella carta di origine, unico per provincia.
  objectId Int
  province String @db.VarChar(4)

  /// Testo libero senza limite di lunghezza: sono descrizioni che arrivano da
  /// fuori, e un tetto arbitrario romperebbe l'import alla prima provincia che
  /// lo supera (NOMECOLTU arriva a 100 caratteri).
  /// Tipo forestale: "Faggete", "Cerrete", "Castagneti", "Orno-ostrieti"...
  typeCode String @db.VarChar(12)
  typeName String
  /// Categoria forestale, il livello sopra il tipo.
  categoryName String?

  /// Specie prevalente col nome botanico: "Fagus sylvatica - Faggio".
  speciesCode String? @db.VarChar(8)
  speciesName String?
  /// Seconda specie, dove presente.
  species2Name String?

  /// Governo del bosco: ceduo, fustaia... Conta, perche' i porcini
  /// prediligono la fustaia matura al ceduo appena tagliato.
  management String?

  municipality String?
  areaHa       Float

  geom Unsupported("geometry(MultiPolygon, 4326)")

  importedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([province, objectId])
  @@index([typeCode])
  @@map("forest_polygon")
}
