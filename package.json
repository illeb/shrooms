{
  "name": "mushrooms-predictions",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:libs": "pnpm --filter \"./packages/*\" run build",
    "test": "pnpm run build:libs && pnpm -r run test",
    "typecheck": "pnpm run build:libs && pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,vue,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,yml,yaml}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U mushrooms -d mushrooms"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
